{
  "name": "sdk",
  "version": "0.0.1",
  "private": true,
  "description": "SDK of the x207 barter protocol for AI agents on NEAR: @x207/core, @x207/scheme, @x207/mcp, spec and test vectors, reference facilitator",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "tsc -b --clean",
    "test:sandbox": "X207_SANDBOX=1 vitest run --passWithNoTests sandbox register.sandbox",
    "conformance": "node conformance/run.mjs",
    "conformance:python": "node conformance/run.mjs --cmd \"PYTHONPATH=python python3 -m x207.conformance_adapter\""
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
