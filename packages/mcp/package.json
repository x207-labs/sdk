{
  "name": "@x207/mcp",
  "version": "0.0.6",
  "mcpName": "io.github.x207-labs/x207-mcp",
  "description": "MCP server for x207: read tools for a mutual-credit circle on NEAR (circle, members, epochs, clearing simulation, listings, orders) over stdio and Streamable HTTP",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "x207",
    "near",
    "mutual-credit",
    "agent-payments"
  ],
  "homepage": "https://github.com/x207-labs/x207#readme",
  "bugs": {
    "url": "https://github.com/x207-labs/x207/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x207-labs/sdk.git",
    "directory": "packages/mcp"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "x207-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@x207/core": "0.0.3",
    "@x207/scheme": "0.0.2",
    "@x402/fetch": "2.29.0",
    "zod": "4.6.7"
  }
}
