{
  "name": "@x207/scheme",
  "version": "0.0.2",
  "description": "x402 batch-settlement scheme on the network x207:<circleId>: client, seller middleware, facilitator, and buyer helpers for metered resources and access rent",
  "keywords": [
    "x402",
    "x207",
    "near",
    "mutual-credit",
    "agent-payments"
  ],
  "homepage": "https://github.com/x207-labs/x207#readme",
  "bugs": {
    "url": "https://github.com/x207-labs/x207/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x207-labs/sdk.git",
    "directory": "packages/scheme"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./facilitator": {
      "types": "./dist/facilitator/index.d.ts",
      "default": "./dist/facilitator/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@x207/core": "0.0.3",
    "@x402/core": "2.29.0"
  },
  "devDependencies": {
    "@x402/fetch": "2.29.0"
  }
}
