{
  "name": "@x207/core",
  "version": "0.0.1",
  "description": "x207 core: signed credit vouchers, client of the x207-circle contract, NEP-297 event parser, and the formats of barter, invoices, orders, licenses and access rent",
  "keywords": [
    "x402",
    "x207",
    "near",
    "mutual-credit",
    "agent-payments"
  ],
  "homepage": "https://github.com/x207-labs/x207#readme",
  "bugs": {
    "url": "https://github.com/x207-labs/x207/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x207-labs/sdk.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./signer": {
      "types": "./dist/signer.d.ts",
      "default": "./dist/signer.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "abi:generate": "node scripts/generate-contract-types.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@x402/core": "2.29.0",
    "near-api-js": "7.4.0"
  }
}
