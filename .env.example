# Variable names without values except defaults. Copy to .env; .env is not committed.

# Facilitator URL called by the resource server (Spec Binding x402, section 8).
FACILITATOR_URL=

# --- apps/facilitator ---
# Circles served, comma-separated: <circleId>=<contract account>, e.g. agents-main=x207-circle.near
X207_CIRCLES=
# HTTP port (default 8080)
PORT=
# Comma-separated NEAR RPC list for failover; empty = FastNEAR then rpc.mainnet.near.org from @x207/core.
# Point to a near-sandbox RPC for a relayer to a sandbox contract.
NEAR_RPC_URLS=
# RPC call timeout in ms (default 10000, ADR-25)
RPC_TIMEOUT_MS=
# SQLite file of the D3 pending store (default ./pending.sqlite)
X207_PENDING_DB=
# Registration mode: empty or cumulative (default, register_cumulative). per_request (demo mode): each /settle calls register_voucher and waits for finality (X207_SETTLE_TIMEOUT_MS, default 10000), then answers settlement_pending if it runs over; needs a relayer account.
X207_REGISTER_MODE=
# How long /settle waits in per_request mode before settlement_pending, in milliseconds (empty: 10000)
X207_SETTLE_TIMEOUT_MS=
# Relayer for register_cumulative; both variables are filled together (SD-028)
X207_RELAYER_ACCOUNT_ID=
X207_RELAYER_PRIVATE_KEY=
# Relayer gas key (NEP-611, SD-031): parallel registration on different nonce lanes without nonce conflicts. That key is attached to the relayer account
# (AddKey gas key with the number of lanes, then fund the balance); LANES = number of lanes used (1..1024). Empty: regular access key, sequential registration.
# The NEAR `exact` key uses X207_RELAYER_PRIVATE_KEY, so the gas key is kept separate here.
X207_GAS_KEY_PRIVATE_KEY=
X207_GAS_KEY_LANES=
