# Nama variabel tanpa nilai kecuali default. Salin ke .env; .env tidak di-commit.

# URL facilitator yang dipanggil resource server (Spec Binding x402, bagian 8).
FACILITATOR_URL=

# --- apps/facilitator ---
# Lingkaran yang dilayani, dipisah koma: <circleId>=<akun kontrak>, mis. agents-main=x207-circle.near
X207_CIRCLES=
# Port HTTP (default 8080)
PORT=
# Daftar RPC NEAR dipisah koma untuk failover; kosong = FastNEAR lalu rpc.mainnet.near.org dari @x207/core.
# Arahkan ke RPC near-sandbox untuk relayer ke kontrak sandbox.
NEAR_RPC_URLS=
# Timeout panggilan RPC dalam ms (default 10000, ADR-25)
RPC_TIMEOUT_MS=
# Berkas SQLite pending store D3 (default ./pending.sqlite)
X207_PENDING_DB=
# Mode registrasi: kosong atau cumulative (default, register_cumulative). per_request (mode demo): tiap /settle memanggil register_voucher dan menunggu final (X207_SETTLE_TIMEOUT_MS, default 10000), lalu menjawab settlement_pending bila lewat; butuh akun relayer.
X207_REGISTER_MODE=
# Batas tunggu /settle di mode per_request sebelum settlement_pending, milidetik (kosong: 10000)
X207_SETTLE_TIMEOUT_MS=
# Relayer register_cumulative; kedua variabel diisi bersama (SD-028)
X207_RELAYER_ACCOUNT_ID=
X207_RELAYER_PRIVATE_KEY=
# Gas key relayer (NEP-611, SD-031): registrasi paralel di jalur nonce berbeda tanpa bentrok nonce. Kunci itu terpasang di akun relayer
# (AddKey gas key dengan jumlah jalur, lalu isi saldo); LANES = jumlah jalur yang dipakai (1..1024). Kosong: kunci akses biasa, registrasi berurutan.
# Kunci `exact` NEAR memakai X207_RELAYER_PRIVATE_KEY, jadi gas key dipisah di sini.
X207_GAS_KEY_PRIVATE_KEY=
X207_GAS_KEY_LANES=
